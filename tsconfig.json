{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],

    /* Project behavior */
    "allowJs": false,
    "noEmit": true,
    "incremental": true,

    /* Strictness */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Module & Resolution */
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* React / Next.js */
    "jsx": "react-jsx",
    "plugins": [{ "name": "next" }],

    /* Path aliases */
    "paths": {
      "@/*": ["./*"]
    },

    /* Performance & safety */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },

  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],

  "exclude": ["node_modules"]
}
